# =============================================================
#  KAI Nuvari — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# =============================================================

# ── Hedera (required for native HTS/HCS rails) ───────────────
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=your_hedera_operator_private_key_hex_here
HEDERA_NETWORK=testnet

# Hedera token IDs already created on testnet
NEXT_PUBLIC_YBOB_ID=0.0.9617204
NEXT_PUBLIC_YBOB_TOKEN_ID=0.0.9617204
NEXT_PUBLIC_YTOKEN_ID=0.0.9617199

# KAIBAR HTS token ID — set after running scripts/hedera/create-kaibar-token.ts
HEDERA_KAIBAR_TOKEN_ID=0.0.xxxxxx
NEXT_PUBLIC_KAIBAR_TOKEN_ID=0.0.xxxxxx

# Conservation NFT HTS token ID — set after running scripts/hedera/create-conservation-nft.ts
HEDERA_CONNFT_TOKEN_ID=0.0.xxxxxx
NEXT_PUBLIC_CONNFT_TOKEN_ID=0.0.xxxxxx

# HCS audit topic ID — set after running scripts/hedera/create-hcs-topic.ts
HEDERA_AUDIT_TOPIC_ID=0.0.xxxxxx

# HashConnect / WalletConnect project ID (for HashPack wallet connection)
NEXT_PUBLIC_HASHCONNECT_PROJECT_ID=f63851554285ee5785f0645981c49bf3

# ── RPC endpoints ────────────────────────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
HEDERA_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api

# Hedera Mirror Node (read layer)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── EVM / Sepolia ─────────────────────────────────────────────
WALLET_ADDRESS=0xYourEVMWalletAddressHere
PRIVATE_KEY=your_64_char_hex_evm_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
CHAIN_ID=11155111

# Deployed Sepolia contract addresses (auto-written by deploy scripts)
KAI_AGENT_REGISTRY=
KAI_ESCROW_ADDRESS=
NEXT_PUBLIC_CENTS_ADDRESS=0x1bd79052747A236Aca137380394da27771e95eeA
USDC_SEPOLIA_ADDRESS=

# Agent deterministic addresses (auto-set by deploy-agent-infra.ts)
KAI_AGENT_TX_ANALYST_ADDRESS=
KAI_AGENT_PORTFOLIO_HEALTH_ADDRESS=
KAI_AGENT_CONTRACT_AUDITOR_ADDRESS=
KAI_AGENT_DAO_DRAFTER_ADDRESS=
KAI_AGENT_CODE_GEN_ADDRESS=

# ── x402 payment rails ────────────────────────────────────────
X402_FACILITATOR_URL=https://x402-hedera-production.up.railway.app

# ── AI / Groq (required for all AI agents) ───────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Agent server ──────────────────────────────────────────────
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_PRIVATE_KEY=your_agent_signing_key_here

# ── Database (Prisma — required for KaiBar, referrals, airdrop) ──
# Dev:  file:./prisma/dev.db   (SQLite, no setup needed)
# Prod: postgresql://user:pass@host:5432/dbname
DATABASE_URL=file:./prisma/dev.db

# ── Privy (embedded wallets — required for Google login flow) ─
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# ── M-Pesa (Safaricom Daraja API) ────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ── Misc ──────────────────────────────────────────────────────
# Set to "true" to force-rebuild the ChromaDB knowledge index
REBUILD_INDEX=false

# ── TrueForge agent harness (optional — local or self-hosted) ─────────────────
# Run the harness locally: npx @truefoundry/trueforge
NEXT_PUBLIC_TRUEFORGE_URL=http://localhost:3001
TRUEFORGE_API_KEY=
